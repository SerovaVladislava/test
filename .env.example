# Скопируйте этот файл в .env. Файл .env не коммитится (см. .gitignore).

# Провайдер LLM:
#   anthropic  — Claude (лучшее качество, нужен платный ключ)
#   openrouter — OpenRouter или другой OpenAI-совместимый API (есть бесплатные модели, ключ бесплатный)
#   ollama     — локальная модель (бесплатно, без ключа, нужно ~6 ГБ свободной памяти для 7B)
CARD_PROVIDER=anthropic

# --- Claude (CARD_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
# Глубина рассуждений модели: low | medium | high | xhigh | max
CARD_EFFORT=medium
# Серверный fallback на другую модель при отказе: default | off
CARD_FALLBACKS=default

# --- OpenRouter (CARD_PROVIDER=openrouter) ---
# Бесплатный ключ: https://openrouter.ai/keys (регистрация без карты)
OPENROUTER_API_KEY=
# Адрес OpenAI-совместимого API (OpenRouter, LM Studio, vLLM…)
CARD_OPENROUTER_URL=https://openrouter.ai/api/v1
# Как просить JSON: json_schema (строгая схема) | json_object (для моделей без поддержки схем)
CARD_JSON_MODE=json_schema

# --- Ollama (CARD_PROVIDER=ollama) ---
# Адрес сервера Ollama
CARD_OLLAMA_URL=http://127.0.0.1:11434
# Окно контекста, токенов (у Ollama по умолчанию 2048 — для промпта карточки мало)
CARD_NUM_CTX=8192

# --- Общие ---
# Модель; по умолчанию claude-opus-5-5 (anthropic), nvidia/nemotron-3.5-super-vl:free (openrouter), qwen2.5:7b (ollama)
CARD_MODEL=
# Сколько всего попыток генерации, если автопроверка нашла ошибки (длина текста, выдуманные значения)
CARD_MAX_ATTEMPTS=3
# Таймаут одного запроса, секунды; по умолчанию 180, для ollama — 1800
CARD_TIMEOUT=
